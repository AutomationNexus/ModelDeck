{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(./config/secrets.yaml)",
      "Read(**/config/secrets.yaml)",
      "Read(./secrets.yaml)",
      "Read(**/secrets.yaml)",
      "Read(**/.credentials.json)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(Get-Content .env*)",
      "Bash(type .env*)",
      "Bash(cat .env*)",
      "Bash(Get-Content config/secrets.yaml*)",
      "Bash(type config/secrets.yaml*)",
      "Bash(cat config/secrets.yaml*)",
      "Bash(Get-Content **/.credentials.json*)",
      "Bash(type **/.credentials.json*)",
      "Bash(cat **/.credentials.json*)",
      "Bash(git push origin dev:*)",
      "Bash(git push origin main:*)"
    ]
  }
}
